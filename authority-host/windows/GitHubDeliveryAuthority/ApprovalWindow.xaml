<Window
    x:Class="GitHubDeliveryAuthority.ApprovalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delivery Authority">
    <Grid x:Name="RootLayout"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Padding="31,28,31,28">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ApprovalLayoutStates">
                <VisualState x:Name="NarrowApprovalState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootLayout.Padding" Value="18,16,18,16" />
                        <Setter Target="HeaderPanel.Margin" Value="0,0,0,16" />
                        <Setter Target="BranchGrantText.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="BranchGrantControls.(Grid.Row)" Value="1" />
                        <Setter Target="BranchGrantControls.(Grid.Column)" Value="0" />
                        <Setter Target="BranchGrantControls.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="BranchGrantControls.HorizontalAlignment" Value="Left" />
                        <Setter Target="BranchGrantControls.Margin" Value="0,12,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideApprovalState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="680" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootLayout.Padding" Value="31,28,31,28" />
                        <Setter Target="HeaderPanel.Margin" Value="0,0,0,22" />
                        <Setter Target="BranchGrantText.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BranchGrantControls.(Grid.Row)" Value="0" />
                        <Setter Target="BranchGrantControls.(Grid.Column)" Value="1" />
                        <Setter Target="BranchGrantControls.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="BranchGrantControls.HorizontalAlignment" Value="Right" />
                        <Setter Target="BranchGrantControls.Margin" Value="12,0,0,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="18"
                    Margin="0,0,0,22">
            <FontIcon Glyph="&#xE83D;"
                      FontSize="46"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel Spacing="7">
                <TextBlock Text="Approve GitHub mutation"
                           Style="{StaticResource TitleTextBlockStyle}"
                           TextWrapping="WrapWholeWords" />
                <Border Padding="9,4"
                        CornerRadius="6"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="READY" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="14"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="0,0,0,14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" VerticalAlignment="Center" />
                <TextBlock x:Name="RepositoryText"
                           Grid.Column="1"
                           Text="owner/repo"
                           FontFamily="Cascadia Mono, Consolas"
                           FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Proposed action"
                   Opacity="0.68"
                   Margin="0,0,0,8" />

        <Border Grid.Row="3"
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="0,0,0,14">
            <ScrollViewer x:Name="ActionScrollViewer"
                          MinHeight="110"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <TextBlock x:Name="ActionText"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4"
                Padding="14"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="0,0,0,14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE72E;"
                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                          FontSize="22"
                          VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Security" FontWeight="SemiBold" />
                    <TextBlock Text="Windows Hello approves only this displayed batch."
                               Opacity="0.72"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Padding="14"
                CornerRadius="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="0,0,0,14">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="BranchGrantText"
                            Grid.Row="0"
                            Grid.Column="0"
                            Spacing="3"
                            MinWidth="0">
                    <TextBlock x:Name="BranchGrantTitle"
                               Text="Only this branch" FontWeight="SemiBold" />
                    <TextBlock x:Name="BranchGrantCaption"
                               Text="Temporarily skip repeated Hello prompts for this exact branch."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.72"
                               TextWrapping="WrapWholeWords" />
                    <TextBlock x:Name="BranchGrantScopeText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.72"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
                <StackPanel x:Name="BranchGrantControls"
                            Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="BranchGrantDuration"
                              Width="92"
                              SelectedIndex="0"
                              IsEnabled="False"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="1 min" Tag="1" />
                        <ComboBoxItem Content="2 min" Tag="2" />
                        <ComboBoxItem Content="3 min" Tag="3" />
                        <ComboBoxItem Content="4 min" Tag="4" />
                        <ComboBoxItem Content="5 min" Tag="5" />
                        <ComboBoxItem Content="6 min" Tag="6" />
                        <ComboBoxItem Content="7 min" Tag="7" />
                        <ComboBoxItem Content="8 min" Tag="8" />
                        <ComboBoxItem Content="9 min" Tag="9" />
                        <ComboBoxItem Content="10 min" Tag="10" />
                    </ComboBox>
                    <ToggleSwitch x:Name="BranchGrantToggle"
                                  Toggled="BranchGrantToggle_Toggled"
                                  VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="6"
              ColumnSpacing="10"
              Padding="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ApproveButton"
                    Content="☺  Approve with Windows Hello"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="Approve_Click" />
            <Button Grid.Column="1"
                    x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="112"
                    Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>

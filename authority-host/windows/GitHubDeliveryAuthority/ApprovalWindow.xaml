<Window
    x:Class="GitHubDeliveryAuthority.ApprovalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delivery Authority">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" Margin="0,0,0,22">
            <FontIcon Glyph="&#xE83D;" FontSize="46" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <StackPanel Spacing="7"><TextBlock Text="Approve GitHub mutation" Style="{StaticResource TitleTextBlockStyle}"/><Border Padding="9,4" CornerRadius="6" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"/><TextBlock Text="READY" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;"/><TextBlock x:Name="RepositoryText" Text="owner/repo" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold"/></StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,18"><TextBlock Text="Proposed action" Opacity="0.68"/><Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"><TextBlock x:Name="ActionText" TextWrapping="Wrap" FontWeight="SemiBold"/></Border></StackPanel>

        <Border Grid.Row="3" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="22"/><StackPanel><TextBlock Text="Security" FontWeight="SemiBold"/><TextBlock Text="Windows Hello approves only this displayed batch." Opacity="0.72" TextWrapping="Wrap"/></StackPanel></StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="14" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Only this branch" FontWeight="SemiBold"/><TextBlock Text="Temporarily skip repeated Hello prompts for this exact branch." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.72"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><ComboBox x:Name="BranchGrantDuration" Width="92" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="1 min" Tag="1"/><ComboBoxItem Content="2 min" Tag="2"/><ComboBoxItem Content="3 min" Tag="3"/><ComboBoxItem Content="4 min" Tag="4"/><ComboBoxItem Content="5 min" Tag="5"/></ComboBox><ToggleSwitch x:Name="BranchGrantToggle" IsEnabled="False"/></StackPanel></Grid>
        </Border>

        <Grid Grid.Row="5" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ApproveButton" Content="☺  Approve with Windows Hello" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Approve_Click"/><Button Grid.Column="1" x:Name="CancelButton" Content="Cancel" MinWidth="112" Click="Cancel_Click"/></Grid>
    </Grid>
</Window>

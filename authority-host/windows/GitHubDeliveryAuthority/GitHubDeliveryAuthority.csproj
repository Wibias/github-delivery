<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AllowlistDialog.cs" />
    <Compile Remove="ApprovalDialog.cs" />
    <Compile Remove="AuthorityHostContext.cs" />
    <Compile Remove="GitHubTheme.cs" />
    <Compile Remove="SetupDialog.cs" />
    <Compile Remove="ShieldMark.cs" />
    <Compile Remove="StatusPill.cs" />
  </ItemGroup>

  <Target Name="CopyUnpackagedWinUiResourcesToPublish"
          AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None' and '$(PublishDir)' != ''">
    <ItemGroup>
      <AuthorityCompiledXaml Include="$(XamlGeneratedOutputPath)*.xbf" />
      <AuthorityProjectPri Include="$(ProjectPriFullPath)"
                           Condition="'$(ProjectPriFullPath)' != '' and Exists('$(ProjectPriFullPath)')" />
    </ItemGroup>
    <Error Condition="'@(AuthorityCompiledXaml)' == ''"
           Text="WinUI XBF output is missing; unpackaged publish cannot load compiled XAML resources." />
    <Error Condition="'@(AuthorityProjectPri)' == ''"
           Text="WinUI project PRI output is missing; unpackaged publish cannot resolve ms-appx resources." />
    <Copy SourceFiles="@(AuthorityCompiledXaml)"
          DestinationFiles="@(AuthorityCompiledXaml->'$(PublishDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(AuthorityProjectPri)"
          DestinationFiles="@(AuthorityProjectPri->'$(PublishDir)resources.pri')"
          Condition="!Exists('$(PublishDir)resources.pri')" />
    <Error Condition="!Exists('$(PublishDir)resources.pri')"
           Text="Published unpackaged WinUI resource index is missing: resources.pri" />
  </Target>
</Project>

<Window
    x:Class="GitHubDeliveryAuthority.ControlCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:GitHubDeliveryAuthority"
    mc:Ignorable="d"
    Title="Delivery Authority">

    <Grid x:Name="RootLayout"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DashboardLayoutStates">
                <VisualState x:Name="NarrowDashboardState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OverviewContent.Padding" Value="18,16,18,20" />
                        <Setter Target="SettingsContent.Padding" Value="18,16,18,20" />
                        <Setter Target="ActivityColumnsHeader.Visibility" Value="Collapsed" />


                        <Setter Target="DashboardPrimaryColumn.Width" Value="*" />
                        <Setter Target="DashboardSecondaryColumn.Width" Value="0" />
                        <Setter Target="DashboardCardsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="DashboardRow3.Height" Value="Auto" />
                        <Setter Target="DashboardRow4.Height" Value="Auto" />

                        <Setter Target="ActivityCard.(Grid.Row)" Value="0" />
                        <Setter Target="ActivityCard.(Grid.Column)" Value="0" />
                        <Setter Target="ActivityCard.(Grid.RowSpan)" Value="1" />
                        <Setter Target="ActivityCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="AllowlistCard.(Grid.Row)" Value="1" />
                        <Setter Target="AllowlistCard.(Grid.Column)" Value="0" />
                        <Setter Target="AllowlistCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="GrantCard.(Grid.Row)" Value="2" />
                        <Setter Target="GrantCard.(Grid.Column)" Value="0" />
                        <Setter Target="GrantCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DiagnosticsCard.(Grid.Row)" Value="3" />
                        <Setter Target="DiagnosticsCard.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="QuickSettingsCard.(Grid.Row)" Value="4" />
                        <Setter Target="QuickSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="QuickSettingsCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="MediumDashboardState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OverviewContent.Padding" Value="24,20,24,24" />
                        <Setter Target="SettingsContent.Padding" Value="24,20,24,24" />
                        <Setter Target="ActivityColumnsHeader.Visibility" Value="Visible" />


                        <Setter Target="DashboardPrimaryColumn.Width" Value="*" />
                        <Setter Target="DashboardSecondaryColumn.Width" Value="*" />
                        <Setter Target="DashboardCardsGrid.ColumnSpacing" Value="16" />
                        <Setter Target="DashboardRow3.Height" Value="0" />
                        <Setter Target="DashboardRow4.Height" Value="0" />

                        <Setter Target="ActivityCard.(Grid.Row)" Value="0" />
                        <Setter Target="ActivityCard.(Grid.Column)" Value="0" />
                        <Setter Target="ActivityCard.(Grid.RowSpan)" Value="1" />
                        <Setter Target="ActivityCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="AllowlistCard.(Grid.Row)" Value="1" />
                        <Setter Target="AllowlistCard.(Grid.Column)" Value="0" />
                        <Setter Target="AllowlistCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="GrantCard.(Grid.Row)" Value="1" />
                        <Setter Target="GrantCard.(Grid.Column)" Value="1" />
                        <Setter Target="GrantCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DiagnosticsCard.(Grid.Row)" Value="2" />
                        <Setter Target="DiagnosticsCard.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="QuickSettingsCard.(Grid.Row)" Value="2" />
                        <Setter Target="QuickSettingsCard.(Grid.Column)" Value="1" />
                        <Setter Target="QuickSettingsCard.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="WideDashboardState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1360" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OverviewContent.Padding" Value="31,24,31,28" />
                        <Setter Target="SettingsContent.Padding" Value="31,24,31,28" />
                        <Setter Target="ActivityColumnsHeader.Visibility" Value="Visible" />


                        <Setter Target="DashboardPrimaryColumn.Width" Value="2.15*" />
                        <Setter Target="DashboardSecondaryColumn.Width" Value="*" />
                        <Setter Target="DashboardCardsGrid.ColumnSpacing" Value="16" />
                        <Setter Target="DashboardRow3.Height" Value="0" />
                        <Setter Target="DashboardRow4.Height" Value="0" />

                        <Setter Target="ActivityCard.(Grid.Row)" Value="0" />
                        <Setter Target="ActivityCard.(Grid.Column)" Value="0" />
                        <Setter Target="ActivityCard.(Grid.RowSpan)" Value="2" />
                        <Setter Target="ActivityCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="AllowlistCard.(Grid.Row)" Value="0" />
                        <Setter Target="AllowlistCard.(Grid.Column)" Value="1" />
                        <Setter Target="AllowlistCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="GrantCard.(Grid.Row)" Value="1" />
                        <Setter Target="GrantCard.(Grid.Column)" Value="1" />
                        <Setter Target="GrantCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="DiagnosticsCard.(Grid.Row)" Value="2" />
                        <Setter Target="DiagnosticsCard.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="QuickSettingsCard.(Grid.Row)" Value="2" />
                        <Setter Target="QuickSettingsCard.(Grid.Column)" Value="1" />
                        <Setter Target="QuickSettingsCard.(Grid.ColumnSpan)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <NavigationView x:Name="Navigation"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="0"
                        ExpandedModeThresholdWidth="1360"
                        CompactPaneLength="48"
                        OpenPaneLength="172"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview" IsSelected="True" ToolTipService.ToolTip="Overview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <ScrollViewer x:Name="OverviewPage"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <Grid x:Name="OverviewContent"
                          Padding="18,16,18,20"
                          HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MinWidth="0">
                                <TextBlock Text="Audit dashboard"
                                           Style="{StaticResource TitleTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Monitor activity, approvals, and policy enforcement."
                                           Margin="0,4,0,0"
                                           Opacity="0.72"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="10,5"
                                    CornerRadius="6"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="8"
                                             Height="8"
                                             Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="READY" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Padding="18"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,16">
                            <Grid x:Name="SummaryMetricsGrid" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="SummaryColumn0" Width="*" />
                                    <ColumnDefinition x:Name="SummaryColumn1" Width="*" />
                                    <ColumnDefinition x:Name="SummaryColumn2" Width="*" />
                                    <ColumnDefinition x:Name="SummaryColumn3" Width="*" />
                                    <ColumnDefinition x:Name="SummaryColumn4" Width="*" />
                                    <ColumnDefinition x:Name="SummaryColumn5" Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="SummarySecondRow" Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="SummaryMetric0"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Center"
                                            Spacing="3">
                                    <FontIcon Glyph="&#xE83D;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="AllowlistedCount" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Repositories" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Allowlisted" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="SummaryMetric1"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Center"
                                            Spacing="3">
                                    <FontIcon Glyph="&#xE8D7;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="ActiveGrantCount" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Active" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Grants" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="SummaryMetric2"
                                            Grid.Row="0"
                                            Grid.Column="4"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Center"
                                            Spacing="3">
                                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock x:Name="ApprovedTodayCount" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Approved" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Today" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="SummaryMetric3"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Center"
                                            Spacing="3">
                                    <FontIcon Glyph="&#xE711;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock x:Name="DeniedTodayCount" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Denied" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Today" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="SummaryMetric4"
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Center"
                                            Spacing="3">
                                    <FontIcon Glyph="&#xE823;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock x:Name="ExpiredTodayCount" Text="0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Expired" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Today" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="DashboardCardsGrid"
                              Grid.Row="2"
                              ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DashboardPrimaryColumn" Width="*" />
                                <ColumnDefinition x:Name="DashboardSecondaryColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="DashboardRow3" Height="Auto" />
                                <RowDefinition x:Name="DashboardRow4" Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="ActivityCard"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,16">
                                <StackPanel Spacing="12">
                                    <Grid x:Name="ActivityHeaderGrid" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Recent activity / Audit trail"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid x:Name="ActivityColumnsHeader"
                                          Visibility="Collapsed"
                                          ColumnSpacing="10"
                                          Opacity="0.65">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Time" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="Repository" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="Action" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="Status" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="Actor" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <ListView x:Name="ActivityList"
                                              SelectionMode="None"
                                              IsItemClickEnabled="False"
                                              MinHeight="280"
                                              MaxHeight="420"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplateSelector>
                                            <local:ActivityListItemTemplateSelector>
                                                <local:ActivityListItemTemplateSelector.DaySeparatorTemplate>
                                                    <DataTemplate x:DataType="local:ActivityDaySeparatorItem">
                                                        <StackPanel Spacing="8" Margin="0,8,0,4">
                                                            <TextBlock Text="{x:Bind Label}"
                                                                       FontWeight="SemiBold"
                                                                       Opacity="0.82" />
                                                            <Border Height="1"
                                                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </local:ActivityListItemTemplateSelector.DaySeparatorTemplate>
                                                <local:ActivityListItemTemplateSelector.EventTemplate>
                                                    <DataTemplate x:DataType="local:ActivityEventItem">
                                                        <Grid ColumnSpacing="12" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="56" />
                                                                <ColumnDefinition Width="1.4*" />
                                                                <ColumnDefinition Width="1.4*" />
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Time}"
                                                                       FontFamily="Cascadia Mono, Consolas"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{x:Bind RepositoryDisplay}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{x:Bind Action}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{x:Bind Status}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="4"
                                                                       Text="{x:Bind Actor}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </local:ActivityListItemTemplateSelector.EventTemplate>
                                            </local:ActivityListItemTemplateSelector>
                                        </ListView.ItemTemplateSelector>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border x:Name="AllowlistCard"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,16">
                                <StackPanel Spacing="10">
                                    <Grid x:Name="AllowlistHeaderGrid" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Repository allowlist"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="AddRepositoryButton"
                                                    Content="+ Add repository"
                                                    Padding="7,2"
                                                    Click="AddRepository_Click" />
                                            <Button x:Name="RemoveRepositoryButton"
                                                    Content="Remove selected"
                                                    Padding="7,2"
                                                    IsEnabled="False"
                                                    Click="RemoveRepository_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <ListView x:Name="AllowlistList"
                                              SelectionMode="Single"
                                              SelectionChanged="AllowlistList_SelectionChanged"
                                              MinHeight="135"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="WrapWholeWords"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock x:Name="AllowlistStatusText"
                                               Text=""
                                               Opacity="0.72"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="GrantCard"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,16">
                                <StackPanel Spacing="10">
                                    <Grid x:Name="GrantHeaderGrid" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Active temporary grants"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="RevokeGrantButton"
                                                Grid.Column="1"
                                                Content="Revoke selected"
                                                Padding="7,2"
                                                IsEnabled="False"
                                                Click="RevokeGrant_Click" />
                                    </Grid>
                                    <ListView x:Name="GrantList"
                                              SelectionMode="Single"
                                              SelectionChanged="GrantList_SelectionChanged"
                                              MinHeight="145"
                                              HorizontalContentAlignment="Stretch"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           TextWrapping="WrapWholeWords"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DiagnosticsCard"
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE946;"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" MinWidth="0">
                                            <TextBlock Text="All systems operational"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="No issues detected."
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock x:Name="DiagnosticsUpdated"
                                                   Grid.Column="2"
                                                   Text="Updated now"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="QuickSettingsCard"
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Quick settings" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Protection mode"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ProtectionModeText"
                                                   Grid.Column="1"
                                                   Text="Loading…"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <Button Content="Open settings"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Click="OpenSettings_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch">
                    <Grid x:Name="SettingsContent"
                          Padding="18,16,18,20"
                          HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Choose when GitHub Delivery must ask for Windows Hello before executing a mutation."
                                       Margin="0,4,0,0"
                                       Opacity="0.72"
                                       TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Padding="20"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,16">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Protection mode" FontWeight="SemiBold" FontSize="16" />
                                <RadioButton x:Name="OffModeRadio" GroupName="ProtectionMode" Content="Off" />
                                <TextBlock Text="No Windows Hello prompts. Normal GitHub Delivery authorization, workflow, head-freshness and policy rules still apply."
                                           Margin="28,-10,0,0"
                                           Opacity="0.70"
                                           TextWrapping="WrapWholeWords" />
                                <RadioButton x:Name="SensitiveModeRadio" GroupName="ProtectionMode" Content="Sensitive actions (Recommended)" />
                                <TextBlock Text="Require Windows Hello for pushes, merges, PR creation and other high-assurance or autonomous mutations."
                                           Margin="28,-10,0,0"
                                           Opacity="0.70"
                                           TextWrapping="WrapWholeWords" />
                                <RadioButton x:Name="AllModeRadio" GroupName="ProtectionMode" Content="Every GitHub write" />
                                <TextBlock Text="Require Windows Hello for every executed GitHub mutation, including comments and reviews."
                                           Margin="28,-10,0,0"
                                           Opacity="0.70"
                                           TextWrapping="WrapWholeWords" />
                                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ApplyProtectionModeButton"
                                            Content="Apply"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="ApplyProtectionMode_Click" />
                                    <TextBlock x:Name="SettingsStatusText"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Opacity="0.72"
                                               TextWrapping="WrapWholeWords" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Padding="20"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Installation" FontWeight="SemiBold" FontSize="16" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Delivery Authority" Opacity="0.68" />
                                    <TextBlock x:Name="HostVersionText"
                                               Grid.Column="1"
                                               Text="Unknown"
                                               FontFamily="Cascadia Mono, Consolas"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Source commit" Opacity="0.68" />
                                    <TextBlock x:Name="HostSourceText"
                                               Grid.Column="1"
                                               Text="Unknown"
                                               FontFamily="Cascadia Mono, Consolas"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Config file" Opacity="0.68" />
                                    <TextBlock x:Name="ConfigPathText"
                                               Grid.Column="1"
                                               Text="Unknown"
                                               FontFamily="Cascadia Mono, Consolas"
                                               TextWrapping="WrapWholeWords" />
                                </Grid>

                                <Grid ColumnSpacing="16" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel MinWidth="0">
                                        <TextBlock Text="Start Delivery Authority when I sign in"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="WrapWholeWords" />
                                        <TextBlock x:Name="AutostartStatusText"
                                                   Text="Checking…"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Opacity="0.72"
                                                   TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutostartToggle"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Toggled="AutostartToggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>

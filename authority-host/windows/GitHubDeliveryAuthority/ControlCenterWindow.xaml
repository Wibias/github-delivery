<Window
    x:Class="GitHubDeliveryAuthority.ControlCenterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Delivery Authority">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="172">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview"><NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Activity" Tag="activity" IsSelected="True"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Allowlist" Tag="allowlist"><NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Temporary grants" Tag="grants"><NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics"><NavigationViewItem.Icon><SymbolIcon Symbol="ReportHacked" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border Padding="12" Margin="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE83D;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="18" />
                        <StackPanel>
                            <TextBlock Text="Protection active" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProtectionModeSidebar" Text="Loading…" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.72" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Padding="28,24,28,28" MaxWidth="1180" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Audit dashboard" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Monitor activity, approvals, and policy enforcement." Margin="0,4,0,0" Opacity="0.72" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="10,5" CornerRadius="6" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"/><TextBlock Text="READY" FontWeight="SemiBold"/></StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,16">
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="3"><FontIcon Glyph="&#xE83D;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="AllowlistedCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Repositories" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="Allowlisted" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="3"><FontIcon Glyph="&#xE8D7;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="ActiveGrantCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Active" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="Grants" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="3"><FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/><TextBlock x:Name="ApprovedTodayCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Approved" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="Today" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="3"><FontIcon Glyph="&#xE711;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/><TextBlock x:Name="DeniedTodayCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Denied" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="Today" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="3"><FontIcon Glyph="&#xE823;" Foreground="{ThemeResource SystemFillColorCautionBrush}"/><TextBlock x:Name="ExpiredTodayCount" Text="0" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Expired" Style="{StaticResource CaptionTextBlockStyle}"/><TextBlock Text="Today" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnSpacing="16" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid><TextBlock Text="Recent activity / Audit trail" FontWeight="SemiBold"/><Button Content="View full activity" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Padding="9,3" IsEnabled="False"/></Grid>
                                <Grid ColumnSpacing="10" Opacity="0.65"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="Time"/><TextBlock Grid.Column="1" Text="Repository"/><TextBlock Grid.Column="2" Text="Action"/><TextBlock Grid.Column="3" Text="Status"/><TextBlock Grid.Column="4" Text="Actor"/></Grid>
                                <ListView x:Name="ActivityList" SelectionMode="None" IsItemClickEnabled="False" MinHeight="280" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="16">
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10"><Grid><TextBlock Text="Repository allowlist" FontWeight="SemiBold"/><Button Content="+ Add repository" HorizontalAlignment="Right" Padding="7,2" IsEnabled="False"/></Grid><ListView x:Name="AllowlistList" SelectionMode="None" MinHeight="135"/></StackPanel>
                            </Border>
                            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="10"><Grid><TextBlock Text="Active temporary grants" FontWeight="SemiBold"/><Button x:Name="RevokeGrantButton" Content="Revoke selected" HorizontalAlignment="Right" Padding="7,2" IsEnabled="False" Click="RevokeGrant_Click"/></Grid><ListView x:Name="GrantList" SelectionMode="Single" SelectionChanged="GrantList_SelectionChanged" MinHeight="145"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="10"><TextBlock Text="Diagnostics" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE946;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><StackPanel><TextBlock Text="All systems operational" FontWeight="SemiBold"/><TextBlock Text="No issues detected." Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel><TextBlock x:Name="DiagnosticsUpdated" Text="Updated now" HorizontalAlignment="Right" VerticalAlignment="Center"/></StackPanel></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12"><TextBlock Text="Quick settings" FontWeight="SemiBold"/><Grid><TextBlock Text="Protection mode"/><TextBlock x:Name="ProtectionModeText" Grid.Column="1" Text="Loading…" HorizontalAlignment="Right"/></Grid><Grid><TextBlock Text="Notifications"/><ToggleSwitch IsOn="True" HorizontalAlignment="Right"/></Grid><Button Content="Open settings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OpenSettings_Click"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
